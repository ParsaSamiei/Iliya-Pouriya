# Copy to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# Local dev (npm run dev against `docker compose up -d postgres`):
DATABASE_URL="postgresql://app:changeme@localhost:5432/iliya_pouriya"
# Neon / other hosted Postgres often ship `?sslmode=require` — the app
# normalizes that to `sslmode=verify-full` at runtime to silence pg v8 warnings.
# In docker-compose.yml this is composed from POSTGRES_* below instead.
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iliya_pouriya

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- File uploads -----------------------------------------------------
# Local dev default is ./public/uploads if unset. In production this points
# at the mounted volume (see docker-compose.yml / 05_DATABASE.md).
# UPLOADS_DIR=./public/uploads

# --- Contact form notifications (optional) -----------------------------
# Leave blank to skip email notifications — messages still save to the DB
# and show up in /admin/messages either way.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_NOTIFY_FROM=

# Copy to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# Local dev (npm run dev against `docker compose up -d postgres`).
# Compose publishes Postgres on 127.0.0.1:5432 only.
DATABASE_URL="postgresql://app:changeme@localhost:5432/iliya_pouriya"
# Neon / other hosted Postgres often ship `?sslmode=require` — the app
# normalizes that to `sslmode=verify-full` at runtime to silence pg v8 warnings.
# Inside docker compose, DATABASE_URL is rebuilt from POSTGRES_* and points
# at the postgres service, so this host URL is for the host process only.
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iliya_pouriya

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Required when the app sits behind the two nginx layers.
# Auth.js rejects the forwarded Host without it. Harmless for `next dev`.
AUTH_TRUST_HOST=true

# Public site URL. Baked into the image at `docker compose build` time
# (NEXT_PUBLIC_*). Changing it requires a rebuild, not just an .env edit.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- File uploads -----------------------------------------------------
# Local dev default is ./public/uploads if unset. In production this points
# at the mounted volume (see docker-compose.yml / 05_DATABASE.md).
# UPLOADS_DIR=./public/uploads

# --- Contact form notifications (optional) -----------------------------
# Leave blank to skip email notifications — messages still save to the DB
# and show up in /admin/messages either way.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_NOTIFY_FROM=

// Prisma schema — see docs/05_DATABASE.md (source of truth for every model
// and the reasoning behind the bilingual _en/_fa pattern below).
//
// Prisma 7 architecture note: the connection URL no longer lives here — the
// CLI (migrate/studio) reads it from prisma.config.ts, and the runtime
// PrismaClient requires an explicit driver adapter (lib/db.ts uses
// @prisma/adapter-pg). See https://pris.ly/d/config-datasource.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkillCategory {
  hardware
  software
  other
}

/// Public lab status for the homepage status board.
enum ProjectStatus {
  ACTIVE
  FIELD
  COMPLETE
}

/// Login for the two site owners. Auth.js credentials provider reads from
/// this table — no other identity provider (see docs/07_ADMIN_PANEL.md).
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

/// The two profile owners. This table will only ever hold two rows —
/// project/post "contributors" always resolve to one or both of these people,
/// never an arbitrary third party (see docs/01_PRODUCT.md).
model Person {
  id             String   @id @default(uuid())
  slug           String   @unique
  nameEn         String   @map("name_en")
  nameFa         String   @map("name_fa")
  title          String
  photoUrl       String?  @map("photo_url")
  bioEn          String?  @map("bio_en")
  bioFa          String?  @map("bio_fa")
  resumeUrlEn    String?  @map("resume_url_en")
  resumeUrlFa    String?  @map("resume_url_fa")
  /// { github, linkedin, email, ... }
  socialLinks    Json?    @map("social_links")
  sortOrder      Int      @default(0) @map("sort_order")

  experience     Experience[]
  skills         Skill[]
  projects       ProjectContributor[]
  posts          BlogPostAuthor[]

  @@map("people")
}

/// Per-person work timeline.
model Experience {
  id             String    @id @default(uuid())
  personId       String    @map("person_id")
  person         Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleEn         String    @map("role_en")
  roleFa         String    @map("role_fa")
  organization   String
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date") // null = present
  descriptionEn  String?   @map("description_en")
  descriptionFa  String?   @map("description_fa")
  sortOrder      Int       @default(0) @map("sort_order")

  @@index([personId])
  @@map("experience")
}

/// Per-person skills/tools.
model Skill {
  id        String        @id @default(uuid())
  personId  String        @map("person_id")
  person    Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  name      String
  category  SkillCategory
  sortOrder Int           @default(0) @map("sort_order")

  @@index([personId])
  @@map("skills")
}

/// Shared portfolio pieces.
model Project {
  id             String    @id @default(uuid())
  slug           String    @unique
  titleEn        String    @map("title_en")
  titleFa        String    @map("title_fa")
  summaryEn      String?   @map("summary_en")
  summaryFa      String?   @map("summary_fa")
  /// Markdown text from the admin panel's editor (components/admin/markdown-editor.tsx),
  /// rendered on the public site via components/site/markdown-content.tsx.
  contentEn      String?   @map("content_en")
  contentFa      String?   @map("content_fa")
  coverImageUrl  String?   @map("cover_image_url")
  /// jsonb array of media URLs
  gallery        Json?
  /// jsonb array of strings
  tags           Json?
  /// { github, demo, publication, ... }
  externalLinks     Json?          @map("external_links")
  isFeatured        Boolean        @default(false) @map("is_featured")
  publishedAt       DateTime?      @map("published_at") // null = draft
  status            ProjectStatus  @default(ACTIVE)
  statusUpdatedAt   DateTime?      @map("status_updated_at")
  showOnStatusBoard Boolean        @default(true) @map("show_on_status_board")
  sortOrder         Int            @default(0) @map("sort_order")

  models         ProjectModel[]
  contributors   ProjectContributor[]

  @@index([publishedAt])
  @@index([showOnStatusBoard, status])
  @@map("projects")
}

/// 3D/STL models attached to a project.
model ProjectModel {
  id            String  @id @default(uuid())
  projectId     String  @map("project_id")
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nameEn        String  @map("name_en")
  nameFa        String  @map("name_fa")
  fileUrl       String  @map("file_url")
  fileSizeBytes Int     @map("file_size_bytes")
  sortOrder     Int     @default(0) @map("sort_order")

  @@index([projectId])
  @@map("project_models")
}

/// Many-to-many between projects and people.
model ProjectContributor {
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId  String  @map("person_id")
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([projectId, personId])
  @@map("project_contributors")
}

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  titleEn     String    @map("title_en")
  titleFa     String    @map("title_fa")
  excerptEn   String?   @map("excerpt_en")
  excerptFa   String?   @map("excerpt_fa")
  /// Markdown text — see the same field on Project above.
  contentEn   String?   @map("content_en")
  contentFa   String?   @map("content_fa")
  coverImageUrl String? @map("cover_image_url")
  publishedAt DateTime? @map("published_at") // null = draft
  /// jsonb array
  tags        Json?

  authors     BlogPostAuthor[]

  @@index([publishedAt])
  @@map("blog_posts")
}

/// Many-to-many, same pattern as project_contributors.
model BlogPostAuthor {
  postId   String   @map("post_id")
  post     BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  personId String   @map("person_id")
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([postId, personId])
  @@map("blog_post_authors")
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  email     String
  message   String
  /// which person it's addressed to, or null for "both"
  recipient String?
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  @@map("contact_messages")
}

/// Third-party recommendations / testimonials shown on the homepage.
model Recommendation {
  id             String   @id @default(uuid())
  quoteEn        String   @map("quote_en")
  quoteFa        String   @map("quote_fa")
  authorNameEn   String   @map("author_name_en")
  authorNameFa   String   @map("author_name_fa")
  authorRoleEn   String?  @map("author_role_en")
  authorRoleFa   String?  @map("author_role_fa")
  authorPhotoUrl String?  @map("author_photo_url")
  authorUrl      String?  @map("author_url")
  isPublished    Boolean  @default(true) @map("is_published")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([isPublished, sortOrder])
  @@map("recommendations")
}

/// Key/value table for global content that isn't per-entity — homepage
/// tagline, contact-page copy, site-wide social links, etc.
model SiteSetting {
  key     String @id
  valueEn Json?  @map("value_en")
  valueFa Json?  @map("value_fa")

  @@map("site_settings")
}

enum GalleryMediaType {
  IMAGE
  VIDEO

  @@map("gallery_media_type")
}

/// Site-wide gallery media (images + videos), independent of project galleries.
model GalleryItem {
  id         String           @id @default(uuid())
  mediaType  GalleryMediaType @default(IMAGE) @map("media_type")
  /// Required for IMAGE; optional poster for VIDEO.
  imageUrl   String?          @map("image_url")
  videoUrl   String?          @map("video_url")
  altEn      String?          @map("alt_en")
  altFa      String?          @map("alt_fa")
  captionEn  String?          @map("caption_en")
  captionFa  String?          @map("caption_fa")
  sortOrder  Int              @default(0) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at")

  tags GalleryItemTag[]

  @@index([sortOrder])
  @@map("gallery_items")
}

model GalleryTag {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameEn    String   @map("name_en")
  nameFa    String   @map("name_fa")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  items GalleryItemTag[]

  @@index([isActive, sortOrder])
  @@map("gallery_tags")
}

model GalleryItemTag {
  itemId String      @map("item_id")
  item   GalleryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tagId  String      @map("tag_id")
  tag    GalleryTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("gallery_item_tags")
}

/// Partners / sponsors shown as logos in the site footer only
/// (no dedicated public page). Managed from /admin/sponsors.
model Sponsor {
  id          String   @id @default(uuid())
  name        String
  /// Optional — a sponsor can be listed by name alone.
  logoUrl     String?  @map("logo_url")
  /// Optional outbound link when the logo/name is clicked.
  url         String?
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([isPublished, sortOrder])
  @@map("sponsors")
}

/// Organizations / people the team has worked with — homepage carousel.
/// Separate from Sponsors (footer). Managed from /admin/clients.
model Client {
  id          String   @id @default(uuid())
  nameEn      String   @map("name_en")
  nameFa      String   @map("name_fa")
  /// Optional short note about the collaboration.
  noteEn      String?  @map("note_en")
  noteFa      String?  @map("note_fa")
  logoUrl     String?  @map("logo_url")
  url         String?
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([isPublished, sortOrder])
  @@map("clients")
}
